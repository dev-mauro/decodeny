{
  "name": "decodeny",
  "private": true,
  "description": "Decodeny — visualizador 3D de espacios habitables",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @decodeny/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @decodeny/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "e2e": "pnpm --filter @decodeny/web e2e",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test",
    "prepare": "husky",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "husky": "^9.1.7",
    "lint-staged": "^17",
    "prettier": "^3.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
